# Copy this file to ".env" and fill in the values.

# Supabase Dashboard > Project Settings > API. Both are safe to expose to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional. https://developer.spotify.com/dashboard > your app > Settings.
# Server-side only. Without them, song search uses the iTunes catalogue.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
